# EC2 서버의 docker-compose.prod.yml과 같은 경로에 .env로 복사해서 실제 값 채우기 (git 미추적)

# NeonDB
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Upstash Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true

# 외부 API
GEMINI_API_KEY=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 인증
JWT_SECRET=
GOOGLE_CLIENT_ID=

# CORS — 프론트 도메인 (DuckDNS)
CORS_ALLOWED_ORIGINS=
